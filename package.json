{
  "name": "wasurenagusa-mcp",
  "version": "0.23.0",
  "description": "MCP server that gives AI coding agents persistent memory — auto-detect mistakes, consolidate lessons, inject context on session start",
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/tsutushi0628"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wasurenagusa-mcp": "./dist/index.js",
    "wasurenagusa-context": "./dist/cli/context.js",
    "wasurenagusa-analyze": "./dist/cli/analyze.js",
    "wasurenagusa-spec-update": "./dist/cli/spec-update.js",
    "wasurenagusa-rebuild": "./dist/cli/rebuild.js",
    "wasurenagusa-backfill": "./dist/cli/backfill-worker.js",
    "wasurenagusa-consolidate-all": "./dist/cli/consolidate-all.js",
    "wasurenagusa-scheduler": "./dist/cli/scheduler-setup.js",
    "wasurenagusa-guard": "./dist/cli/guard.js",
    "wasurenagusa-pretool-guard": "./dist/cli/pre-tool-use-guard.js",
    "wasurenagusa-dream-worker": "./dist/cli/dream-worker.js",
    "wasurenagusa-promote": "./dist/cli/promote.js",
    "wasurenagusa-guard-approve": "./dist/cli/guard-approve.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/*.js dist/index.js",
    "start": "node dist/index.js",
    "dev": "npx ts-node --esm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_config_user_agent||'')){console.error('[pnpm-guard] pnpm 専用プロジェクト。npm/yarn install ではなく pnpm install を使うこと');process.exit(1)}\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "coding-agent",
    "memory",
    "claude",
    "cursor",
    "windsurf"
  ],
  "author": "tsutushi0628",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsutushi0628/wasurenagusa-mcp.git"
  },
  "homepage": "https://github.com/tsutushi0628/wasurenagusa-mcp#readme",
  "bugs": {
    "url": "https://github.com/tsutushi0628/wasurenagusa-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "scripts/maintenance/archive-transcripts.mjs",
    "scripts/replay/lib/session-project.mjs",
    "prompts/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/tokenizer": "0.0.4",
    "@genkit-ai/anthropic": "^0.2.0",
    "@genkit-ai/compat-oai": "^1.42.0",
    "@genkit-ai/google-genai": "^1.42.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "genkit": "^1.42.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "fast-check": "4.9.0",
    "firebase-admin": "^13.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@fastify/busboy@3": ">=3.2.2 <4",
      "@grpc/grpc-js@1": ">=1.14.5 <2",
      "@hono/node-server@1": ">=1.19.15 <2",
      "@opentelemetry/auto-instrumentations-node@0": ">=0.75.0 <1",
      "@protobufjs/utf8@1": ">=1.1.1 <2",
      "@tootallnate/once@2": ">=2.0.1 <3",
      "@vitest/mocker@4": ">=4.1.11 <5",
      "adm-zip@0": ">=0.6.1 <1",
      "ajv@8": ">=8.18.0 <9",
      "body-parser@1": ">=1.20.6 <2",
      "body-parser@2": ">=2.3.0 <3",
      "brace-expansion@2": ">=2.1.7 <3",
      "esbuild@0": ">=0.28.1 <1",
      "express-rate-limit@8": ">=8.2.2 <9",
      "fast-uri@3": ">=3.1.8 <4",
      "fast-xml-builder@1": ">=1.1.7 <2",
      "fast-xml-parser@5": ">=5.7.0 <6",
      "form-data@2": ">=2.5.6 <3",
      "form-data@4": ">=4.0.6 <5",
      "handlebars@4": ">=4.7.10 <5",
      "hono@4": ">=4.13.7 <5",
      "ip-address@10": ">=10.7.1 <11",
      "nanoid@3": ">=3.3.12 <4",
      "path-to-regexp@0": ">=0.1.13 <1",
      "path-to-regexp@8": ">=8.4.0 <9",
      "picomatch@4": ">=4.0.4 <5",
      "postcss@8": ">=8.5.23 <9",
      "protobufjs@7": ">=7.6.5 <8",
      "proxy-addr@2": ">=2.0.8 <3",
      "qs@6": ">=6.16.0 <7",
      "rollup@4": ">=4.59.0 <5",
      "sharp@0": ">=0.35.5 <1",
      "source-map-js@1": ">=1.2.2 <2",
      "uuid": ">=11.1.1 <12",
      "vite@7": ">=7.3.5 <8",
      "websocket-driver@0": ">=0.7.5 <1",
      "yaml@2": ">=2.8.3 <3"
    }
  }
}
